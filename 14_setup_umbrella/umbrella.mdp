; Umbrella Sampling Production Simulation Window Template
integrator              = md
nsteps                  = 2500000       ; 5000 ps (5.0 ns) per window
dt                      = 0.002

; Output control
nstxout-compressed      = 5000          ; Save coordinates every 10 ps
nstenergy               = 5000
nstlog                  = 5000

; Bond parameters
continuation            = yes
constraint_algorithm    = lincs
constraints             = h-bonds
lincs_iter              = 1
lincs_order             = 4

; Nonbonded settings
cutoff-scheme           = Verlet
nstlist                 = 20
rcoulomb                = 1.0
rvdw                    = 1.0
coulombtype             = PME

; Temperature coupling
tcoupl                  = v-rescale
tc-grps                 = Solute_Complex Water_and_ions
tau_t                   = 0.1     0.1
ref_t                   = 310     310

; Pressure coupling
pcoupl                  = Parrinello-Rahman
pcoupltype              = isotropic
tau_p                   = 2.0
ref_p                   = 1.0
compressibility         = 4.5e-5

; Periodic boundary conditions
pbc                     = xyz

; Restraints: maintain receptor backbone stability while allowing loops and sidechains to relax
define                  = -DPOSRES

; Pull code settings for umbrella sampling window
pull                    = yes
pull-ngroups            = 2
pull-ncoords            = 1
pull-group1-name        = Binding_Pocket
pull-group2-name        = Ligand
pull-coord1-type        = umbrella
pull-coord1-geometry    = distance
pull-coord1-groups      = 1 2
pull-coord1-dim         = Y Y Y
pull-coord1-rate        = 0.0           ; Static harmonic umbrella restraint
pull-coord1-k           = 1000.0        ; Force constant (kJ/mol/nm^2)
pull-coord1-init        = 0.50          ; Window reference distance (nm), customized per window
pull-nstxout            = 50            ; Output pull distance every 0.1 ps
pull-nstfout            = 50            ; Output pull force every 0.1 ps
